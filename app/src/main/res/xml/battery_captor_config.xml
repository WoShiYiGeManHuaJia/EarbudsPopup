<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.4 电量抓取无障碍服务配置。

  用途：系统耳机弹窗（或「小米耳机」App）会在开盖瞬间显示
  「左耳 / 右耳 / 充电盒」三个真实百分比。本服务读取那个窗口的文本，
  把三个真实数字交给本 App 的弹窗，让自定义弹窗也显示同一组真值。

  边界（必须如实告知用户）：
    · 只读取屏幕上已经存在的电量文本，不主动连接耳机、不联网、不上传
    · 数字是耳机真实上报值，但上游是系统弹窗，不是本 App 直连耳机
    · 系统 ROM 大版本更新或弹窗改版后，可能要重新适配解析规则
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/captor_desc"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:canRequestTouchExplorationMode="false"
    android:notificationTimeout="80"
    android:settingsActivity="com.yuanbao.earbuds.MainActivity" />
