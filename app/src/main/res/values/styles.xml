<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FFFF6900</item>
        <item name="colorPrimaryVariant">#FFE65C00</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#FF00BFA5</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorAccent">#FFFF6900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFF5F6F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FFF5F6F8</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 主按钮：实心 -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- 次级按钮：描边 -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="strokeColor">#FFFF6900</item>
        <item name="android:textColor">#FFFF6900</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- 危险按钮 -->
    <style name="Widget.App.Button.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="strokeColor">#FFD8434A</item>
        <item name="android:textColor">#FFD8434A</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- 输入框 -->
    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FF20232A</item>
        <item name="android:textColorHint">#FFA0A6B0</item>
    </style>

    <!-- 分区小标题 -->
    <style name="TextSectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF1B1D22</item>
    </style>

    <!-- 卡片内字段标签 -->
    <style name="TextFieldLabel">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">#FF6B7280</item>
    </style>

    <!-- 开关 -->
    <style name="Widget.App.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FF20232A</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <string-array name="popup_position">
        <item>屏幕顶部</item>
        <item>屏幕居中</item>
        <item>屏幕底部</item>
    </string-array>

    <string-array name="popup_anim">
        <item>缩放淡入</item>
        <item>底部上滑</item>
        <item>顶部下滑</item>
    </string-array>

    <!-- 系统级弹窗 Activity：透明全屏、独立任务、系统转场动画 -->
    <style name="Theme.Popup.System" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/PopupWindowAnimation</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="PopupWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_in</item>
        <item name="android:windowExitAnimation">@anim/popup_out</item>
    </style>

    <!-- 新增：弹窗引擎 -->
    <string-array name="popup_engine">
        <item>系统级（透明 Activity，锁屏也能弹）</item>
        <item>悬浮窗（兼容性最好）</item>
        <item>智能：先系统级，失败自动降级悬浮窗</item>
    </string-array>

</resources>
