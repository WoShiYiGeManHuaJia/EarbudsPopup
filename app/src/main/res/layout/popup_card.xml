<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗卡片（类 realme 排版）：
    ① 媒体区（图片 / GIF）—— 占满除详情外的全部空间
    ② 底部渐变 —— 图片与详情之间的过渡，让两者融合
    ③ 详情区 —— 设备名 + 电量 + 提示，弹出 0.8 秒后缓慢升起

  关键：详情区「始终占位」，只做 alpha + translationY 动画，绝不用 GONE。
       一旦用 GONE 会在升起时触发重新测量，导致 ImageView 重建、GIF 被打断重置。
  无关闭按钮，点击卡片任意位置关闭。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ① 媒体区 -->
        <FrameLayout
            android:id="@+id/gifWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- scaleType=matrix：由代码用 Matrix 应用 fitCenter + 用户双指变换 -->
            <com.yuanbao.earbuds.RoundedImageView
                android:id="@+id/popupImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="弹窗动画"
                android:scaleType="matrix" />

            <!-- ② 底部渐变：让图片自然过渡到详情区 -->
            <View
                android:id="@+id/gradientFade"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/shimmer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ③ 详情区（始终占位，靠动画升起） -->
        <LinearLayout
            android:id="@+id/detailArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lines="1"
                android:singleLine="true"
                android:text="耳机"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infoBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:lines="1"
                android:singleLine="true"
                android:text="已连接"
                android:textColor="#D9FFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tipText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:lines="1"
                android:singleLine="true"
                android:text="轻触关闭弹窗"
                android:textColor="#8CFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
