<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗卡片：单张液态玻璃卡片，三区纵向划分
    ① GIF 主视觉区  76%
    ② 设备信息窄条  16%
    ③ 操作提示区    8%
  无关闭按钮、无标题栏，点击卡片任意位置关闭。
-->
<!-- 根容器必须 match_parent：卡片的 gravity（上/中/下）是相对它算的，
     一旦缩成 wrap_content 会被父 FrameLayout 贴到左上角，定位全部失效 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ① GIF 主视觉区：占卡片 76% -->
        <FrameLayout
            android:id="@+id/gifWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="76"
            android:padding="8dp">

            <ImageView
                android:id="@+id/popupImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="false"
                android:contentDescription="弹窗动画"
                android:scaleType="fitCenter" />

            <!-- 液态玻璃流光：斜向高光扫过 -->
            <View
                android:id="@+id/shimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 细光泽描边 -->
            <View
                android:id="@+id/gifStroke"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_stroke" />
        </FrameLayout>

        <!-- ② 设备信息窄条：占卡片 16% -->
        <TextView
            android:id="@+id/infoBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="16"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:text="已连接"
            android:textColor="#D1FFFFFF"
            android:textSize="13sp" />

        <!-- ③ 操作提示区：占卡片 8% -->
        <TextView
            android:id="@+id/tipText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lines="1"
            android:singleLine="true"
            android:text="轻触关闭弹窗"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp" />

    </LinearLayout>
</FrameLayout>
