<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="112dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TextSectionTitle" android:text="外观工作台" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="把图片、文字、尺寸、颜色和声音一次调到位。" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_ok" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="LIVE" android:textColor="#FF2B6D58" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="28dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <FrameLayout android:id="@+id/frameWrap" android:layout_width="match_parent" android:layout_height="310dp" android:background="@drawable/bg_preview_stage">
                    <com.yuanbao.earbuds.RoundedImageView android:id="@+id/pvFrameImage" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="弹窗预览" android:scaleType="matrix" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tvFrameHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#BFFFFFFF" android:paddingStart="11dp" android:paddingTop="7dp" android:paddingEnd="11dp" android:paddingBottom="7dp" android:text="未选择图片 · 双指缩放 / 单指拖动" android:textColor="@color/ui_text_primary" android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPickImage" style="@style/AppButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="选择图片 / GIF" android:textSize="12.5sp" app:icon="@drawable/ic_image" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnResetTransform" style="@style/AppButtonTonal" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="重置位置" android:textSize="12.5sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearImage" style="@style/AppButtonTonal" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="清除当前图片" android:textSize="12.5sp" />
                <TextView android:id="@+id/tvHistoryTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="最近使用" android:textColor="@color/ui_text_secondary" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <HorizontalScrollView android:id="@+id/historyScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:id="@+id/historyList" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="内容" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="18dp" android:paddingEnd="18dp" android:paddingBottom="16dp">
                <TextView style="@style/TextLabel" android:text="主标题" />
                <EditText android:id="@+id/etTitle" style="@style/AppEditText" android:hint="Buds 5 Pro 电竞版" android:inputType="text" android:singleLine="true" />
                <TextView style="@style/TextLabel" android:layout_marginTop="16dp" android:text="副标题 · %s 会自动替换成设备名" />
                <EditText android:id="@+id/etSub" style="@style/AppEditText" android:hint="%s 已连接" android:inputType="text" android:singleLine="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="尺寸与动画" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowWidth" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_size" android:contentDescription="宽度"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="弹窗宽度"/><TextView style="@style/TextRowSub" android:text="控制整张卡片在屏幕上的占比"/></LinearLayout><TextView android:id="@+id/tvWidth" style="@style/TextRowValue" android:text="296 dp"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowRadius" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_layers" android:contentDescription="圆角"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="卡片圆角"/><TextView style="@style/TextRowSub" android:text="决定整体是否更接近系统级弹窗"/></LinearLayout><TextView android:id="@+id/tvRadius" style="@style/TextRowValue" android:text="26 dp"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowImgH" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_image" android:contentDescription="图片比例"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="图片占弹窗高度"/><TextView style="@style/TextRowSub" android:text="建议从 65%～75% 之间调整"/></LinearLayout><TextView android:id="@+id/tvImgH" style="@style/TextRowValue" android:text="70%"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowDuration" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_animation" android:contentDescription="时长"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="显示时长"/><TextView style="@style/TextRowSub" android:text="GIF 时建议不短于单轮播放时间"/></LinearLayout><TextView android:id="@+id/tvDuration" style="@style/TextRowValue" android:text="4500 ms"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowPos" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_preview" android:contentDescription="位置"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="弹出位置"/><TextView style="@style/TextRowSub" android:text="顶部 / 居中 / 底部"/></LinearLayout><TextView android:id="@+id/tvPos" style="@style/TextRowValue" android:text="居中"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowAnim" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_animation" android:contentDescription="动画"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="入场动画"/><TextView style="@style/TextRowSub" android:text="决定弹窗出现时的节奏"/></LinearLayout><TextView android:id="@+id/tvAnim" style="@style/TextRowValue" android:text="缩放淡入"/></LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="颜色与层次" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swAutoColor" style="@style/AppItem" android:drawableStart="@drawable/ic_color" android:text="根据图片自动配色" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowBg" style="@style/AppRow"><View android:id="@+id/swatchBg" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_thumb"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="卡片背景色"/><TextView android:id="@+id/tvBg" style="@style/TextRowSub" android:text="#1FFFFFFF"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="编辑"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowTextColor" style="@style/AppRow"><View android:id="@+id/swatchText" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_thumb"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="文字颜色"/><TextView android:id="@+id/tvTextColor" style="@style/TextRowSub" android:text="#FFFFFFFF"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="编辑"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文字颜色快捷预设" android:textColor="@color/ui_text_secondary" android:textSize="11sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/tabColorTitle" style="@style/AppButtonTonal" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:minHeight="0dp" android:text="标题" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/tabColorBattery" style="@style/AppButtonTonal" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:layout_weight="1" android:minHeight="0dp" android:text="电量" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/tabColorStatus" style="@style/AppButtonTonal" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:layout_weight="1" android:minHeight="0dp" android:text="状态" android:textSize="11sp" />
                    </LinearLayout>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none"><LinearLayout android:id="@+id/colorDots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" /></HorizontalScrollView>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowAccent" style="@style/AppRow"><View android:id="@+id/swatchAccent" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_thumb"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="强调色"/><TextView android:id="@+id/tvAccent" style="@style/TextRowSub" android:text="#6750E8"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="编辑"/></LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="弹窗音效" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swSound" style="@style/AppItem" android:drawableStart="@drawable/ic_notification" android:text="弹窗时播放声音" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowSound" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_image" android:contentDescription="音效"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="选择音效文件"/><TextView android:id="@+id/tvSoundName" style="@style/TextRowSub" android:text="未选择（使用系统提示音）"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="编辑"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowSoundVol" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_tune" android:contentDescription="音量"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="音量"/><TextView style="@style/TextRowSub" android:text="试听时同样使用这个音量"/></LinearLayout><TextView android:id="@+id/tvSoundVol" style="@style/TextRowValue" android:text="80%"/></LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSound" style="@style/AppButtonTonal" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="试听当前音效" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="建议每次改完外观后，从首页“立即测试弹窗”确认真实系统效果。" android:textColor="@color/ui_text_tertiary" android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
