<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="96dp">

    <!-- paddingBottom 96dp：底部导航栏悬浮在内容之上（CoordinatorLayout
         里 bottom gravity 不参与滚动），24dp 会被导航条压住，
         导致最后一部分内容点不到 / 看不见。 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 弹窗图片 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:text="弹窗图片" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp"
            android:padding="16dp">

            <!-- 相框：整个预览弹窗，双指可缩放 / 拖动 -->
            <FrameLayout
                android:id="@+id/frameWrap"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/bg_preview_stage">

                <com.yuanbao.earbuds.RoundedImageView
                    android:id="@+id/pvFrameImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="弹窗预览"
                    android:scaleType="matrix" />

                <TextView
                    android:id="@+id/tvFrameHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:text="未选择图片 · 双指缩放 / 单指拖动"
                    android:textColor="#99000000"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    style="@style/AppButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="选择图片 / GIF"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_image"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetTransform"
                    style="@style/AppButtonTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="重置缩放"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearImage"
                style="@style/AppButtonTonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="44dp"
                android:text="清除图片"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== 文案 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="文案" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp"
            android:padding="16dp">

            <TextView
                style="@style/TextLabel"
                android:text="主标题" />

            <EditText
                android:id="@+id/etTitle"
                style="@style/AppEditText"
                android:hint="Buds 5 Pro 电竞版"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="14dp"
                android:text="副标题（%s 会替换成设备名，留空则不显示）" />

            <EditText
                android:id="@+id/etSub"
                style="@style/AppEditText"
                android:hint="%s 已连接"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ===== 尺寸 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="尺寸与动画" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp">

            <LinearLayout
                android:id="@+id/rowWidth"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="宽度"
                    android:src="@drawable/ic_size" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="弹窗宽度" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="建议占屏幕宽度的 70%" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWidth"
                    style="@style/TextRowValue"
                    android:text="296 dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowRadius"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="圆角"
                    android:src="@drawable/ic_layers" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="卡片圆角" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRadius"
                    style="@style/TextRowValue"
                    android:text="26 dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowImgH"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="图片占比"
                    android:src="@drawable/ic_image" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="图片占弹窗高度" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="官方规范约为 70%" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvImgH"
                    style="@style/TextRowValue"
                    android:text="70%" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowDuration"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="时长"
                    android:src="@drawable/ic_animation" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="显示时长" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="要 ≥ GIF 单轮时长" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDuration"
                    style="@style/TextRowValue"
                    android:text="4500 ms" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowPos"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="位置"
                    android:src="@drawable/ic_preview" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="弹出位置" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPos"
                    style="@style/TextRowValue"
                    android:text="居中" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowAnim"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="动画"
                    android:src="@drawable/ic_animation" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="入场动画" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAnim"
                    style="@style/TextRowValue"
                    android:text="缩放淡入" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 配色 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="配色" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAutoColor"
                style="@style/AppItem"
                android:drawableStart="@drawable/ic_color"
                android:text="根据图片自动配色"
                android:textSize="15.5sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="8dp"
            android:elevation="1dp">

            <LinearLayout
                android:id="@+id/rowBg"
                style="@style/AppRow">

                <View
                    android:id="@+id/swatchBg"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_thumb" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="卡片背景色" />
                    <TextView
                        android:id="@+id/tvBg"
                        style="@style/TextRowSub"
                        android:text="#1FFFFFFF" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowTextColor"
                style="@style/AppRow">

                <View
                    android:id="@+id/swatchText"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_thumb" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="文字颜色" />
                    <TextView
                        android:id="@+id/tvTextColor"
                        style="@style/TextRowSub"
                        android:text="#FFFFFFFF" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowAccent"
                style="@style/AppRow">

                <View
                    android:id="@+id/swatchAccent"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_thumb" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="强调色" />
                    <TextView
                        android:id="@+id/tvAccent"
                        style="@style/TextRowSub"
                        android:text="#FF00E5A0" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 弹窗音效 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="弹窗音效" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swSound"
                style="@style/AppItem"
                android:drawableStart="@drawable/ic_notification"
                android:text="弹窗时播放声音"
                android:textSize="15.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowSound"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="音效"
                    android:src="@drawable/ic_image" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="选择音效文件" />
                    <TextView
                        android:id="@+id/tvSoundName"
                        style="@style/TextRowSub"
                        android:text="未选择（用系统提示音）" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowSoundVol"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="音量"
                    android:src="@drawable/ic_tune" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="音量" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSoundVol"
                    style="@style/TextRowValue"
                    android:text="80%" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestSound"
            style="@style/AppButtonTonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="46dp"
            android:text="试听"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="改完记得点首页的「立即测试弹窗」看实际效果。"
            android:textSize="11.5sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
