<?xml version="1.0" encoding="utf-8"?>
<!--
  竖屏弹窗：
  - 卡片背景是一层「实时高斯模糊」：绑定顶部图片 / GIF 并逐帧重算，
    卡片底色因此来自图片本身，整体观感更统一；
  - 上传的图片 / GIF 所在区域（imageWrap）不透明，始终显示原图，不会被模糊盖住；
  - 模糊层高度 = 卡片底部 − 图片区底部（顶部留一段渐隐带），由代码按实测尺寸对齐。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_panel"
    android:outlineProvider="background"
    android:clipToOutline="true">

    <com.woshiyigemanhuajia.btpopup.widget.LiveBlurView
        android:id="@+id/popupBlurBg"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/imageWrap"
            android:layout_width="match_parent"
            android:layout_height="176dp">

            <ImageView
                android:id="@+id/popupImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_popup_image_mask"
                android:clipToOutline="true"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:id="@+id/noImageHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_popup_image_mask">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:alpha="0.7"
                    android:src="@drawable/ic_image"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="未设置图片 / GIF"
                    android:textColor="@color/popup_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_headset"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="蓝牙耳机"
                    android:textColor="@color/popup_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已连接"
                    android:textColor="@color/popup_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSourceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_popup_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                android:textColor="@color/popup_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_popup_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvLeftLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左耳"
                    style="@style/PopupLabel" />

                <TextView
                    android:id="@+id/tvLeftPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="--%"
                    style="@style/PopupPercent" />

                <ProgressBar
                    android:id="@+id/pbLeft"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_battery" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_popup_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvRightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="右耳"
                    style="@style/PopupLabel" />

                <TextView
                    android:id="@+id/tvRightPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="--%"
                    style="@style/PopupPercent" />

                <ProgressBar
                    android:id="@+id/pbRight"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_battery" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_popup_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvCaseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充电仓"
                    style="@style/PopupLabel" />

                <TextView
                    android:id="@+id/tvCasePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="--%"
                    style="@style/PopupPercent" />

                <ProgressBar
                    android:id="@+id/pbCase"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_battery" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
