<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6F8"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <!-- ===================== 顶部头图 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="耳机弹窗"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.9"
                    android:text="自定义连接弹窗 · 免 Root"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_ok"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="检测中…"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:alpha="0.95"
                android:contentDescription="图标"
                android:src="@drawable/ic_headphone" />
        </LinearLayout>

        <!-- ===================== 一键设置 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/TextSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="快速开始" />
            </LinearLayout>

            <TextView
                android:id="@+id/permStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="检查中…"
                android:textColor="#FF4B5563"
                android:textSize="12.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetup"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⚡  一键设置（自动跑完所有命令）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPerm"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="去授权" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatteryOpt"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="省电白名单" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdb"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="复制命令" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlockMi"
                style="@style/Widget.App.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="屏蔽小米原生弹窗 · 查看指引" />
        </LinearLayout>

        <!-- ===================== 实时预览 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/TextSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="实时预览" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:text="改完即时更新"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_preview_stage"
                android:padding="14dp">

                <!-- 预览卡片：与真实弹窗同一套结构 -->
                <LinearLayout
                    android:id="@+id/pvCard"
                    android:layout_width="252dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:elevation="10dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/pvImageArea"
                        android:layout_width="match_parent"
                        android:layout_height="176dp">

                        <ImageView
                            android:id="@+id/pvImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="弹窗图片"
                            android:scaleType="centerCrop" />

                        <View
                            android:id="@+id/pvFade"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:layout_gravity="bottom" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/pvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Buds 5 Pro 电竞版"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pvSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:gravity="center"
                            android:text="已连接"
                            android:textColor="#FFFFFFFF"
                            android:textSize="10.5sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.yuanbao.earbuds.BatteryRingView
                                android:id="@+id/pvRingEarbud"
                                android:layout_width="46dp"
                                android:layout_height="46dp" />

                            <LinearLayout
                                android:id="@+id/pvBoxGroup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="26dp"
                                android:orientation="vertical">

                                <com.yuanbao.earbuds.BatteryRingView
                                    android:id="@+id/pvRingBox"
                                    android:layout_width="46dp"
                                    android:layout_height="46dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTest"
                    style="@style/Widget.App.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="立即测试弹窗" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="保存设置" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== 开关 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/TextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="基本开关" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swMaster"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="总开关（弹窗服务）" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#14000000" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swWired"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="有线耳机插入也弹窗" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#14000000" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAutoStart"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开机自启" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#14000000" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swBattery"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尝试显示电量" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#14000000" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swCase"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="显示充电盒电量" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#14000000" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swAutoColor"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="根据图片自动配色" />
        </LinearLayout>

        <!-- ===================== 触发设备 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/TextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="触发设备" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="刷新设备列表" />
        </LinearLayout>

        <!-- ===================== 弹窗内容 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/TextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="弹窗内容" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    style="@style/Widget.App.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="选择图片 / GIF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearImage"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="清除" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:contentDescription="所选图片"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0A000000"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/TextFieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主标题" />

                <EditText
                    android:id="@+id/etTitle"
                    style="@style/Widget.App.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buds 5 Pro 电竞版"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    style="@style/TextFieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="副标题（%s 替换为设备名，留空不显示）" />

                <EditText
                    android:id="@+id/etSub"
                    style="@style/Widget.App.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="%s 已连接"
                    android:inputType="text"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextFieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="卡片背景色" />

                        <EditText
                            android:id="@+id/etBg"
                            style="@style/Widget.App.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="#F2141620"
                            android:inputType="text"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextFieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="文字颜色" />

                        <EditText
                            android:id="@+id/etTextColor"
                            style="@style/Widget.App.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="#FFFFFFFF"
                            android:inputType="text"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/TextFieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="电竞强调色（电量条 / 顶条）" />

                <EditText
                    android:id="@+id/etAccent"
                    style="@style/Widget.App.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="#FF00E5A0"
                    android:inputType="text"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 尺寸调节 -->
            <TextView
                android:id="@+id/tvWidth"
                style="@style/TextFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="弹窗宽度"
                android:textColor="#FF20232A"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="160" />

            <TextView
                android:id="@+id/tvRadius"
                style="@style/TextFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="圆角"
                android:textColor="#FF20232A"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />

            <TextView
                android:id="@+id/tvImgH"
                style="@style/TextFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="图片占比"
                android:textColor="#FF20232A"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbImgH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200" />

            <TextView
                android:id="@+id/tvDuration"
                style="@style/TextFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="显示时长"
                android:textColor="#FF20232A"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="39" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="弹出位置" />

                    <Spinner
                        android:id="@+id/spPos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/popup_position" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="入场动画" />

                    <Spinner
                        android:id="@+id/spAnim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:entries="@array/popup_anim" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== 系统级效果 ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    style="@style/TextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="系统级效果" />
            </LinearLayout>

            <TextView
                style="@style/TextFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="弹出引擎" />

            <Spinner
                android:id="@+id/spEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/popup_engine" />

            <TextView
                android:id="@+id/tvDim"
                style="@style/TextFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="背景压暗"
                android:textColor="#FF20232A"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbDim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="70"
                android:progress="30" />

            <TextView
                android:id="@+id/tvBlur"
                style="@style/TextFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="背景模糊半径"
                android:textColor="#FF20232A"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40"
                android:progress="24" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swLock"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="锁屏 / 熄屏时也弹" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#14000000" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNoFocus"
                style="@style/Widget.App.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="不夺取焦点（游戏时不打断）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiPerm"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="复制 MIUI 授权命令" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.6"
                android:lineSpacingExtra="2dp"
                android:text="系统级引擎在小米上还受「后台弹出界面」限制，点一键设置会自动处理"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===================== 底部提示 ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/tips"
            android:textColor="#FF7A8290"
            android:textSize="11.5sp" />

    </LinearLayout>
</ScrollView>
