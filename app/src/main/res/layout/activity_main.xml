<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F7F9"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 权限 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 权限状态"
            android:textColor="#FF6900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:text="检查中…"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPerm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="去授权" />

            <Button
                android:id="@+id/btnBatteryOpt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="省电白名单" />

            <Button
                android:id="@+id/btnAdb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="复制ADB" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBlockMi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="屏蔽小米原生快连弹窗（K70 Pro 指引）" />

        <!-- ===== 开关 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="② 开关"
            android:textColor="#FF6900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总开关（弹窗服务）" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swWired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="有线耳机插入也弹窗" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开机自启" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="尝试显示电量（视耳机协议而定）" />

        <!-- ===== 设备 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="③ 触发设备"
            android:textColor="#FF6900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="刷新设备列表" />

        <!-- ===== 外观 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="④ 弹窗内容"
            android:textColor="#FF6900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="选择图片/GIF" />

                <Button
                    android:id="@+id/btnClearImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="清除" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#11000000"
                android:contentDescription="弹窗预览"
                android:scaleType="centerCrop" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="主标题，如：耳机已连接"
                android:inputType="text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="副标题，%s 会替换成设备名；留空则不显示"
                android:inputType="text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etBg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="背景色 #E6222426"
                    android:inputType="text"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTextColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="文字色 #FFFFFFFF"
                    android:inputType="text"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="电竞强调色 #FF00E5A0（电量条/顶条）"
                android:inputType="text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="弹窗宽度"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="160" />

            <TextView
                android:id="@+id/tvRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="圆角"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />

            <TextView
                android:id="@+id/tvImgH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="图片高度"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbImgH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="显示时长"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="39" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="弹出位置"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spPos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/popup_position" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="入场动画"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spAnim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/popup_anim" />
        </LinearLayout>

        <!-- ===== 系统级效果 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="⑤ 系统级效果（透明 Activity 引擎）"
            android:textColor="#FF6900"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="弹出引擎"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/popup_engine" />

            <TextView
                android:id="@+id/tvDim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="背景压暗"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbDim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="70"
                android:progress="30" />

            <TextView
                android:id="@+id/tvBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="背景模糊半径"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40"
                android:progress="24" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="锁屏 / 熄屏时也弹（需系统「锁屏显示」权限）" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNoFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="不夺取焦点（打游戏时不打断操作）" />

            <Button
                android:id="@+id/btnMiPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="复制 MIUI「后台弹出界面 / 锁屏显示」授权命令" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.6"
                android:text="系统级引擎在小米上还受「后台弹出界面」限制，需 ADB 授权或去设置里手动打开"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="立即测试弹窗" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/tips"
            android:textColor="#FF666666"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
