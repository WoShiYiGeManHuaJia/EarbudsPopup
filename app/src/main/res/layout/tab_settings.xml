<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="112dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="28dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TextSectionTitle" android:text="运行控制" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="控制服务什么时候工作，以及哪些设备会触发弹窗。" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swMaster" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/ui_divider" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="总开关" android:textColor="@color/ui_text_primary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="关闭后后台服务不再响应蓝牙触发。" android:textColor="@color/ui_text_secondary" android:textSize="11.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="触发方式" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swWired" style="@style/AppItem" android:drawableStart="@drawable/ic_bluetooth" android:text="有线耳机插入也弹窗" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swAutoStart" style="@style/AppItem" android:drawableStart="@drawable/ic_power" android:text="开机自动启动服务" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swBattery" style="@style/AppItem" android:drawableStart="@drawable/ic_battery" android:text="显示耳机电量" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swCase" style="@style/AppItem" android:drawableStart="@drawable/ic_case" android:text="显示充电盒电量" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="触发设备" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_devices" android:tint="@color/md_primary" android:contentDescription="设备" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="已授权设备" android:textColor="@color/ui_text_primary" android:textSize="15sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="勾选后才会触发你的自定义弹窗" android:textColor="@color/ui_text_secondary" android:textSize="11sp"/></LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/deviceList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" style="@style/AppButtonTonal" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="刷新附近设备" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="电量探测" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowClearBattery" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_refresh" android:contentDescription="重置"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="重置电量缓存"/><TextView style="@style/TextRowSub" android:text="下次连接时重新读取"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowProbe" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_battery" android:contentDescription="探测"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="探测三方电量"/><TextView android:id="@+id/tvProbeHint" style="@style/TextRowSub" android:text="扫描 BLE 广播并读取 GATT 服务"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="系统级效果" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowEngine" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_layers" android:contentDescription="引擎"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="弹出引擎"/><TextView style="@style/TextRowSub" android:text="系统级 / 悬浮窗 / 智能"/></LinearLayout><TextView android:id="@+id/tvEngine" style="@style/TextRowValue" android:text="智能"/></LinearLayout>
                <LinearLayout android:id="@+id/rowDim" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_preview" android:contentDescription="压暗"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="背景压暗"/><TextView style="@style/TextRowSub" android:text="弹窗出现时压低后方内容"/></LinearLayout><TextView android:id="@+id/tvDim" style="@style/TextRowValue" android:text="30%"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowBlur" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_preview" android:contentDescription="模糊"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="背景模糊半径"/><TextView style="@style/TextRowSub" android:text="控制后方画面的柔化程度"/></LinearLayout><TextView android:id="@+id/tvBlur" style="@style/TextRowValue" android:text="24 dp"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swLock" style="@style/AppItem" android:drawableStart="@drawable/ic_lock" android:text="锁屏 / 熄屏时也弹" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swNoFocus" style="@style/AppItem" android:drawableStart="@drawable/ic_bolt" android:text="不夺取焦点（游戏时不打断）" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swWindowBlur" style="@style/AppItem" android:drawableStart="@drawable/ic_layers" android:text="窗口级背景模糊（v1.2）" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swTouchClose" style="@style/AppItem" android:drawableStart="@drawable/ic_preview" android:text="点击弹窗外部立即关闭" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="左右耳 + 充电盒真实电量（v1.4）" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#FFEAF6FF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#40000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowCaptorEnable" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_battery" android:contentDescription="抓取"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="开启三项电量抓取"/><TextView android:id="@+id/tvCaptorState" style="@style/TextRowSub" android:text="未开启"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowCaptorTest" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_preview" android:contentDescription="测试"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="立即测试弹窗（看三项）"/><TextView style="@style/TextRowSub" android:text="用最近抓到的真实值弹一次"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:padding="16dp" android:text="原理：系统耳机弹窗上显示的「左耳 / 右耳 / 充电盒」三个数字，本身就是耳机真实上报的值。本功能读取那三个数字，用在自己的弹窗上——数字是真的，与官方显示完全一致。\n\n代价要说清：数据来自系统弹窗，所以系统弹窗不出现时这里也没有数；官方弹窗改版或系统大版本升级后可能需要重新适配。\n\n开启后请同时把本 App 加入无障碍白名单与后台自启动，否则系统会在几分钟后回收该服务。" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="横屏与小窗（v1.2）" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swLandscapeMini" style="@style/AppItem" android:drawableStart="@drawable/ic_size" android:text="横屏时显示迷你小窗" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swLandscapeSkip" style="@style/AppItem" android:drawableStart="@drawable/ic_lock" android:text="横屏时完全不弹窗" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:padding="16dp" android:text="迷你小窗只显示「设备名 + 一个真实电量」，不铺大图。两个开关都关时，横屏照常弹大窗；都开时以「完全不弹」优先。" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="左右耳电量 · HCI 抓包（v1.3）" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#FFF6F1FF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#40000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowHciDial" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_bluetooth" android:contentDescription="抓包"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="开始 / 停止蓝牙日志（免 Root）"/><TextView style="@style/TextRowSub" android:text="复制 *#*#5959#*#* 并打开拨号盘"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowHciDev" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_info" android:contentDescription="开发者"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="打开开发者选项"/><TextView style="@style/TextRowSub" android:text="手动开启「蓝牙 HCI 信息收集日志」"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowHciExport" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_refresh" android:contentDescription="导出"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="导出日志文件"/><TextView style="@style/TextRowSub" android:text="挑选 btsnoop_hci.log 或 bugreport zip 发出去"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:padding="16dp" android:text="操作顺序：① 点第一项拨出代码开始记录 ② 关盖再开盖、连上耳机、打开系统弹窗和「小米耳机」App 各看一次三项电量 ③ 再拨一次代码停止 ④ 等 30 秒，到 MIUI/debug_log 取出 bugreport 压缩包，用第四项发出来。日志里只要有目标耳机的 ACL 数据，就能按真实字节反推左右耳与充电盒电量。这一步不需要 Root，也不需要电脑。" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="后台与省电" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swPowerSave" style="@style/AppItem" android:drawableStart="@drawable/ic_power" android:text="省电模式" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swHideNoti" style="@style/AppItem" android:drawableStart="@drawable/ic_notification" android:text="隐藏后台通知" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swHideRecents" style="@style/AppItem" android:drawableStart="@drawable/ic_lock" android:text="在最近任务里隐藏" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#DFFFFFFF" app:cardCornerRadius="22dp" app:cardElevation="1dp" app:strokeColor="#22000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:text="Android 8+ 的前台服务需要通知。隐藏后台通知后，可以继续运行服务，同时减少通知栏干扰。" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnNotiSettings" style="@style/AppButtonTonal" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="前往系统通知设置" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBattery" style="@style/AppButtonTonal" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="加入电池优化白名单" app:icon="@drawable/ic_shield" app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="崩溃诊断（v1.4.1）" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#FFFFF3E0" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#40000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowCrashLog" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_info" android:contentDescription="崩溃"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="查看 / 导出崩溃日志"/><TextView android:id="@+id/tvCrashState" style="@style/TextRowSub" android:text="暂无崩溃记录"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:padding="16dp" android:text="闪退时系统不留任何痕迹，排查无从下手。本功能会在崩溃瞬间把完整堆栈写进本机文件，你可以直接查看或分享出来。日志只存在本机，不联网、不上传。" android:textColor="@color/ui_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextSectionTitle" android:layout_marginTop="30dp" android:text="关于与权限" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#F5FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowMiPerm" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_shield" android:contentDescription="授权"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="复制 MIUI 授权命令"/><TextView style="@style/TextRowSub" android:text="用于后台弹出界面权限"/></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="前往"/></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowInfo" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_info" android:contentDescription="信息"/><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="不联网 · 不上传 · 配置仅存本地"/><TextView style="@style/TextRowSub" android:text="你的图片、文案与外观设置保存在本机"/></LinearLayout></LinearLayout>
