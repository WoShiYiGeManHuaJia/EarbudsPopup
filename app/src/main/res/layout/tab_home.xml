<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="never"
    android:paddingStart="18dp" android:paddingTop="8dp" android:paddingEnd="18dp" android:paddingBottom="118dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="30dp" app:cardElevation="10dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero" android:padding="22dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="耳机弹窗" android:textColor="#BFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
                        <TextView android:id="@+id/tvDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="检测中…" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#20FFFFFF" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="运行中" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="让每一次连接，都有一张属于你的弹窗。" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold" android:lineSpacingExtra="2dp" />
                <TextView android:id="@+id/permStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:background="#18FFFFFF" android:padding="12dp" android:text="检查中…" android:textColor="#F7FFFFFF" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSetup" style="@style/AppButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:backgroundTint="#FFFFFFFF" android:text="一键完成设置" android:textColor="#FF5E4DD0" app:icon="@drawable/ic_bolt" app:iconGravity="textStart" app:iconTint="#FF5E4DD0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TextSectionTitle" android:text="实时预览" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="修改外观后，这里会立即同步" android:textColor="@color/ui_text_tertiary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_accent" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="LIVE PREVIEW" android:textColor="@color/md_primary" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F7FFFFFF" app:cardCornerRadius="28dp" app:cardElevation="4dp" app:strokeColor="#30000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="320dp" android:background="@drawable/bg_preview_stage" android:padding="18dp">
                    <com.yuanbao.earbuds.RoundedCardLayout android:id="@+id/pvCard" android:layout_width="226dp" android:layout_height="274dp" android:layout_gravity="center" android:elevation="14dp">
                        <FrameLayout android:id="@+id/pvImageArea" android:layout_width="match_parent" android:layout_height="match_parent">
                            <com.yuanbao.earbuds.RoundedImageView android:id="@+id/pvImage" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="弹窗图片" android:scaleType="matrix" />
                            <View android:id="@+id/pvGradient" android:layout_width="match_parent" android:layout_height="96dp" android:layout_gravity="bottom" android:background="@drawable/bg_preview_fade" />
                            <LinearLayout android:id="@+id/pvDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="15dp" android:paddingTop="10dp" android:paddingEnd="15dp" android:paddingBottom="13dp">
                                <TextView android:id="@+id/pvDeviceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="耳机" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_earbuds" android:contentDescription="电量" />
                                    <TextView android:id="@+id/pvBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="78%" android:textColor="#E6FFFFFF" android:textSize="11sp" />
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="12dp" android:src="@drawable/ic_case" android:contentDescription="充电盒" />
                                    <TextView android:id="@+id/pvCase" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="65%" android:textColor="#E6FFFFFF" android:textSize="11sp" />
                                </LinearLayout>
                                <TextView android:id="@+id/pvTip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="轻触关闭弹窗" android:textColor="#AFFFFFFF" android:textSize="9sp" android:maxLines="1" />
                                <TextView android:id="@+id/pvInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.yuanbao.earbuds.RoundedCardLayout>
                </FrameLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTest" style="@style/AppButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="13dp" android:text="立即测试弹窗" app:icon="@drawable/ic_preview" app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="10dp" android:orientation="vertical">
            <TextView style="@style/TextSectionTitle" android:text="快捷操作" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="常用设置放在这里，不用翻很长的页面" android:textColor="@color/ui_text_tertiary" android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F2FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="3dp" app:strokeColor="#28000000" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/rowBlockMi" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_shield" android:contentDescription="屏蔽" /><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="屏蔽小米原生弹窗" /><TextView style="@style/TextRowSub" android:text="避免两个弹窗同时出现" /></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="进入" /></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="57dp" android:background="@color/ui_divider" />
                <LinearLayout android:id="@+id/rowAdb" style="@style/AppRow"><ImageView style="@style/AppRowIcon" android:src="@drawable/ic_bluetooth" android:contentDescription="命令" /><LinearLayout style="@style/AppRowText"><TextView style="@style/TextRowTitle" android:text="复制授权命令" /><TextView style="@style/TextRowSub" android:text="一键设置失效时的备用方式" /></LinearLayout><ImageView style="@style/AppRowIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:contentDescription="进入" /></LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
