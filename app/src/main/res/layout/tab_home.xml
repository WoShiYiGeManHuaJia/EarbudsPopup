<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 状态 Hero 卡 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="弹窗服务"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.9"
                android:text="检测中…"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/permStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="检查中…"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetup"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFFFFFFF"
                android:text="一键设置"
                android:textColor="#FF9B4A00"
                app:icon="@drawable/ic_bolt"
                app:iconGravity="textStart"
                app:iconTint="#FF9B4A00" />
        </LinearLayout>

        <!-- ===== 实时预览 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="实时预览" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_group"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stage"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/pvCard"
                    android:layout_width="232dp"
                    android:layout_height="267dp"
                    android:layout_gravity="center_horizontal"
                    android:elevation="8dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/pvImageArea"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="76"
                        android:padding="7dp"
                        android:background="@drawable/bg_glass_stroke">

                        <ImageView
                            android:id="@+id/pvImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:contentDescription="弹窗图片"
                            android:scaleType="fitCenter" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/pvInfo"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="16"
                        android:gravity="center"
                        android:lines="1"
                        android:singleLine="true"
                        android:text="已连接"
                        android:textColor="#D1FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pvTip"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="8"
                        android:gravity="center"
                        android:lines="1"
                        android:singleLine="true"
                        android:text="轻触关闭弹窗"
                        android:textColor="#8CFFFFFF"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="立即测试弹窗"
                app:icon="@drawable/ic_preview"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ===== 快捷操作 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="快捷操作" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp">

            <LinearLayout
                android:id="@+id/rowBlockMi"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="屏蔽"
                    android:src="@drawable/ic_shield" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="屏蔽小米原生弹窗" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="不关的话两个弹窗会打架" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="?attr/colorSurfaceVariant" />

            <LinearLayout
                android:id="@+id/rowAdb"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="命令"
                    android:src="@drawable/ic_bluetooth" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="复制授权命令" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="一键设置失效时的备用方案" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
