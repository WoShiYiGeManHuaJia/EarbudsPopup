<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="96dp">

    <!-- paddingBottom 96dp：底部导航栏悬浮在内容之上（CoordinatorLayout
         里 bottom gravity 不参与滚动），24dp 会被导航条压住，
         导致最后一部分内容点不到 / 看不见。 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 状态 Hero 卡 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="弹窗服务"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.9"
                android:text="检测中…"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/permStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="检查中…"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetup"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFFFFFFF"
                android:text="一键设置"
                android:textColor="#FF9B4A00"
                app:icon="@drawable/ic_bolt"
                app:iconGravity="textStart"
                app:iconTint="#FF9B4A00" />
        </LinearLayout>

        <!-- ===== 实时预览 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="实时预览" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_group"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stage"
                android:padding="16dp">

                <!-- 预览卡片：必须用 RoundedCardLayout。
                     之前是 LinearLayout，而 LinearLayout 不裁剪子 View，
                     铺满的图片把圆角盖成直角 —— 这就是「预览没圆角」的原因。 -->
                <com.yuanbao.earbuds.RoundedCardLayout
                    android:id="@+id/pvCard"
                    android:layout_width="232dp"
                    android:layout_height="267dp"
                    android:layout_gravity="center_horizontal"
                    android:elevation="8dp">

                    <FrameLayout
                        android:id="@+id/pvImageArea"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.yuanbao.earbuds.RoundedImageView
                            android:id="@+id/pvImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="弹窗图片"
                            android:scaleType="matrix" />

                        <View
                            android:id="@+id/pvGradient"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_gravity="bottom"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:id="@+id/pvDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="11dp">

                            <TextView
                                android:id="@+id/pvDeviceName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:lines="1"
                                android:singleLine="true"
                                android:text="耳机"
                                android:textColor="#FFFFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:contentDescription="电量"
                                    android:src="@drawable/ic_earbuds" />

                                <TextView
                                    android:id="@+id/pvBattery"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:includeFontPadding="false"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:text="78%"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="11sp" />

                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_marginStart="9dp"
                                    android:contentDescription="充电盒"
                                    android:src="@drawable/ic_case" />

                                <TextView
                                    android:id="@+id/pvCase"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:includeFontPadding="false"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:text="65%"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/pvTip"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:includeFontPadding="false"
                                android:lines="1"
                                android:singleLine="true"
                                android:text="轻触关闭弹窗"
                                android:textColor="#99FFFFFF"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/pvInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>
                </com.yuanbao.earbuds.RoundedCardLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="立即测试弹窗"
                app:icon="@drawable/ic_preview"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ===== 快捷操作 ===== -->
        <TextView
            style="@style/TextSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="快捷操作" />

        <LinearLayout
            style="@style/AppGroup"
            android:layout_marginTop="10dp"
            android:elevation="1dp">

            <LinearLayout
                android:id="@+id/rowBlockMi"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="屏蔽"
                    android:src="@drawable/ic_shield" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="屏蔽小米原生弹窗" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="不关的话两个弹窗会打架" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/ui_divider" />

            <LinearLayout
                android:id="@+id/rowAdb"
                style="@style/AppRow">

                <ImageView
                    style="@style/AppRowIcon"
                    android:contentDescription="命令"
                    android:src="@drawable/ic_bluetooth" />

                <LinearLayout style="@style/AppRowText">
                    <TextView
                        style="@style/TextRowTitle"
                        android:text="复制授权命令" />
                    <TextView
                        style="@style/TextRowSub"
                        android:text="一键设置失效时的备用方案" />
                </LinearLayout>

                <ImageView
                    style="@style/AppRowIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="前往"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
