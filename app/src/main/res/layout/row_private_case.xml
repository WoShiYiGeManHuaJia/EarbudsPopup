<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowPrivateCase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">
    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_case"
        android:tint="@color/md_primary"
        android:contentDescription="充电盒" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="充电盒电量推断"
            android:textColor="@color/ui_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvPrivateCaseDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="实验性功能 · 关闭时显示 --%"
            android:textColor="@color/ui_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swPrivateCase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false" />
</LinearLayout>
