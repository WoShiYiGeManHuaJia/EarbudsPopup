<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗根布局：全屏透明窗口。
  压暗层是全屏的（所以不会出现"圆角外露出黑色直角"），
  卡片是居中的圆角 View，由 clipToOutline 裁掉超出圆角的子 View（含顶部图片）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全屏压暗层：点击即关闭 -->
    <View
        android:id="@+id/dimLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_popup_card">

        <!-- 图片区：顶部，会被卡片圆角裁掉上两角 -->
        <FrameLayout
            android:id="@+id/mediaFrame"
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <ImageView
                android:id="@+id/media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_media_default" />

            <!-- 关闭按钮 -->
            <TextView
                android:id="@+id/close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_close_btn" />
        </FrameLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="蓝牙耳机"
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 左耳 / 右耳 / 充电盒：三个槽位恒定都在，读不到就显示占位符 -->
        <LinearLayout
            android:id="@+id/batteryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左耳"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/valLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="右耳"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/valRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充电盒"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/valCase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 整机电量：只有在没有任何分项时才突出显示 -->
        <TextView
            android:id="@+id/valAggregate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="整机 --"
            android:textColor="#4A4A4A"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="数据来源：--"
            android:textColor="#B0B0B0"
            android:textSize="11sp" />

    </LinearLayout>
</FrameLayout>
