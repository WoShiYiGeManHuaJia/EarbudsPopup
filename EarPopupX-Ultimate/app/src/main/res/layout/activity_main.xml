<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#17181C"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/adbOneClick"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="一键 ADB 授权（点一下全部打开）"
            android:textColor="#17181C"
            android:background="@drawable/button" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="启动/恢复监听"
            android:textColor="#17181C"
            android:background="@drawable/button" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="停止监听"
            android:textColor="#17181C"
            android:background="@drawable/button" />

        <Button
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="立即测试弹窗"
            android:textColor="#17181C"
            android:background="@drawable/button" />

        <Switch
            android:id="@+id/autoSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="蓝牙耳机连接自动弹窗"
            android:textColor="#17181C" />

        <Switch
            android:id="@+id/dragSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试弹窗拖动定位"
            android:textColor="#17181C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="弹窗位置与尺寸"
            android:textColor="#17181C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/posLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="左右 (X)"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/xBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="上下 (Y)"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/yBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="宽度"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/widthBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="高度"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/heightBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="圆角"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/radiusBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="玻璃质感"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/blurBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="卡片压暗"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/dimBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示时长（秒）"
            android:textSize="11sp"
            android:textColor="#74767D" />

        <SeekBar android:id="@+id/durationBar" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/pick"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="选择图片/GIF"
                android:textColor="#17181C"
                android:background="@drawable/button" />

            <Button
                android:id="@+id/resetMedia"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="恢复默认素材"
                android:textColor="#17181C"
                android:background="@drawable/button" />
        </LinearLayout>

        <Button
            android:id="@+id/resetPopup"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="恢复弹窗默认设置"
            android:textColor="#17181C"
            android:background="@drawable/button" />

        <LinearLayout
            android:id="@+id/advHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
